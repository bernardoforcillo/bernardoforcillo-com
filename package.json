{
  "name": "@bernardoforcillo-com/monorepo",
  "homepage": "https://bernardoforcillo.com",
  "private": true,
  "licenses": [
    {
      "type": "AGPL-3.0-or-later",
      "url": "https://github.com/bernardoforcillo/bernardoforcillo-com/blob/main/license.md"
    }
  ],
  "author": {
    "name": "Bernardo Forcillo",
    "email": "bernardoforcillo@outlook.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernardoforcillo/bernardoforcillo-com.git"
  },
  "scripts": {
    "dev:web": "pnpm turbo dev --filter=@bernardoforcillo-com/www...",
    "build:web": "pnpm turbo build --filter=@bernardoforcillo-com/www...",
    "container": "node scripts/container-engine.mjs",
    "test": "pnpm turbo test && pnpm test:go",
    "lint": "biome lint --fix .",
    "format": "biome format --fix .",
    "pnpm:update:all": "pnpm up --recursive",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "test:go": "go test ./packages/static-server/... ./apps/www/server/...",
    "test:e2e": "pnpm turbo test:e2e --filter=@bernardoforcillo-com/www",
    "test:config": "node --test \"scripts/verify/**/*.test.mjs\""
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/format": "^19.8.1",
    "@commitlint/types": "^21.2.0",
    "@types/node": "^22.19.17",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "turbo": "^2.9.6",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": ["biome check --write"]
  },
  "packageManager": "pnpm@10.6.2"
}
